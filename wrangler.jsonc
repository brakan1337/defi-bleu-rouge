// Déploiement : npm run db:migrate puis npm run deploy (voir README.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "defi-bleu-rouge",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "defi-db", "database_id": "2d3f563f-a636-42b6-9f92-4854df426b70", "migrations_dir": "migrations" }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "527830323798-7nkh3tuvkr1398ogvothfv895g8k6jfm.apps.googleusercontent.com",
    "ADMIN_EMAILS": "contact@pablomarin.fr",
    "CHALLENGE_START": "2026-11-01",
    "CHALLENGE_END": "2026-11-30",
    "GRACE_DAYS": "2"
  },
  "observability": { "enabled": true }
}
